# Protected runtime input for docker-compose.oidc.yml. Never commit resolved secrets.
# Values are supplied by the secret-manager/OIDC deployment job, not this repository.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_GROUP_CLAIM=groups
OIDC_CA_BUNDLE_PATH=/run/htmp-ca/oidc-ca.pem
OIDC_CA_BUNDLE_HOST_PATH=
