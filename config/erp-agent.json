        "material",
        "user_id",
        "row_limit"
      ]
    },
    {
      "id": "mold_profile",
      "title": "Hồ sơ thiết bị khuôn và tuổi thọ shot",
      "tables": [
        "public.dmhosokhuon",
        "public.dmhosokhuonsp"
      ],
      "join": "dmhosokhuon join dmhosokhuonsp using(ma_khuon)",
      "fields": [
        "ma_khuon",
        "ten_khuon",
        "tong_so_shot",
        "so_shot_bh",
        "ma_sp"
      ],
      "validation": "pending_ui_validation",
      "manifest": "config/erp-reports/ho-so-khuon.json",
      "query_file": "sql/erp-reports/agent-mold-profile.sql",
      "parameters": [
        "mold",
        "material",
        "user_id",
        "row_limit"
      ]
    },
    {
      "id": "mold_label_stock",
      "title": "Báo cáo tồn kho theo số khuôn và die_no",
      "tables": [
        "public.intem_log"
      ],
      "join": "intem_log lateral jsonb_array_elements(data_tem)",
      "fields": [
        "die_no",
        "ma_khuon",
        "status_qc",
        "so_luong"
      ],
      "validation": "pending_ui_validation",
      "manifest": "config/erp-reports/bao-cao-ton-kho-theo-so-khuon.json",
      "query_file": "sql/erp-reports/agent-mold-label-stock.sql",
      "parameters": [
        "material",
        "user_id",
        "row_limit"
      ]
    },
    {
      "id": "sales_orders",
      "title": "Bảng kê đơn hàng bán và đối soát giá",
      "tables": [
        "public.ph64",
        "public.ct64"
      ],
      "join": "ph64 join ct64 using(stt_rec)",
      "fields": [
        "stt_rec",
        "so_ct",
        "ngay_ct",
        "ma_kh",
        "status",
        "ln",
        "ma_vt",
        "dvt",
        "so_luong",
        "gia2",
        "gia_chuan"
      ],
      "validation": "pending_ui_validation",
      "manifest": "config/erp-reports/don-hang-hop-dong.json",
      "query_file": "sql/erp-reports/agent-sales-orders.sql",
      "parameters": [
        "customer",
        "date_from",
        "date_to",
        "user_id",
        "row_limit"
      ]
    },
    {
      "id": "delivery_order",
      "title": "Bảng kê lệnh giao hàng",
      "tables": [
        "public.ph96",
        "public.sys_dmtt"
      ],
      "join": "ph96 left join sys_dmtt on sys_dmtt.ma_ct = 'TO2' and sys_dmtt.status = ph96.status",
      "fields": [
        "stt_rec",
        "so_ct",
        "status",
        "statusname",
        "date0",
        "time0"
      ],
      "validation": "pending_ui_validation",
      "manifest": "config/erp-reports/lenh-giao-hang.json",
      "query_file": "sql/erp-reports/agent-delivery-order.sql",
      "parameters": [
        "delivery_code",
        "user_id",
        "row_limit"
      ]
    },
    {
      "id": "qc_label_status",
      "title": "Báo cáo tồn kho theo trạng thái tem QC",
      "tables": [
        "public.intem_log",
        "public.sys_listoptions"
      ],
      "join": "intem_log left join sys_listoptions on sys_listoptions.form='OQC' and sys_listoptions.form_value = intem_log.status_qc::text",
      "fields": [
        "status_qc",
        "trang_thai_qc",
        "so_tem",
        "so_luong"
      ],
      "validation": "pending_ui_validation",
      "manifest": "config/erp-reports/bao-cao-ton-kho-theo-trang-thai-tem.json",
      "query_file": "sql/erp-reports/agent-qc-label-status.sql",
      "parameters": [
        "material",
        "user_id",
        "row_limit"
      ]
    },
    {
      "id": "replacement_orders",
      "title": "Báo cáo lệnh giao hàng giao bù NG",
      "tables": [
        "public.ph96",
        "public.ct96"
      ],
      "join": "ph96 join ct96 using(stt_rec)",
      "fields": [
        "so_ct",
        "ngay_ct",
        "ma_gd",
        "dien_giai",
        "status",
        "so_luong"
      ],
      "validation": "pending_ui_validation",
      "manifest": "config/erp-reports/bang-ke-lenh-giao-hang.json",
      "query_file": "sql/erp-reports/agent-replacement-orders.sql",
      "parameters": [
        "material",
        "date_from",
        "date_to",
        "user_id",
        "row_limit"
      ]
    }
