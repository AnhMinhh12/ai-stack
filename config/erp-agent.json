        "ma_kh",
        "model",
        "so_ct",
        "status"
      ],
      "validation": "pending_ui_validation",
      "manifest": "config/erp-reports/so-sanh-do-fcst.json",
      "query_file": "sql/erp-reports/agent-forecast-po.sql",
      "parameters": [
        "material",
        "user_id",
        "row_limit"
      ]
    },
    {
      "id": "packaging_spec",
      "title": "Quy cách đóng gói vật tư sản phẩm",
      "tables": [
        "public.dmvt"
      ],
      "join": "none",
      "fields": [
        "ma_vt",
        "ten_vt",
        "dvt",
        "packs",
        "packs0",
        "ma_thung",
        "ma_khay",
        "so_luong_vt_khay",
        "so_luong_thung_pallet",
        "so_luong_sp_tui"
      ],
      "validation": "pending_ui_validation",
      "manifest": "config/erp-reports/quy-cach-dong-goi-ton-kho.json",
      "query_file": "sql/erp-reports/agent-packaging-spec.sql",
