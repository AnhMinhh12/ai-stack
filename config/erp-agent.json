{
  "version": 1,
  "limits": {
    "rounds": 6,
    "tools": 10,
    "db_queries": 4,
    "seconds": 120,
    "rows": 50,
    "result_chars": 12000,
    "context_chars": 48000
  },
  "reports": [
    {
      "id": "sales_lines",
      "title": "Dòng phiếu xuất kho bán hàng",
      "tables": [
        "public.ph81",
        "public.ct81"
      ],
      "join": "ph81.stt_rec = ct81.stt_rec; line key stt_rec + ln",
      "fields": [
        "stt_rec",
        "ln",
        "ngay_lct",
        "ngay_ct",
        "so_ct",
        "ma_dvcs",
        "ma_kh",
        "status",
        "ma_vt",
        "ma_kho",
        "dvt",
        "so_luong"
      ],
      "validation": "pending_ui_validation",
      "manifest": "config/erp-reports/bang-ke-phieu-xuat-kho-ban-hang.json",
      "query_file": "sql/erp-reports/agent-sales-lines.sql",
      "parameters": [
        "user_id",
        "material",
        "date_from",
        "date_to",
        "row_limit"
      ]
    },
    {
      "id": "price_list",
      "title": "Danh mục bảng giá và MOQ",
      "tables": [
        "public.dmbanggia",
        "public.dmbanggiact",
        "public.dmvt",
        "public.dmkh"
      ],
      "join": "dmbanggia.ma_bang_gia = dmbanggiact.ma_bang_gia",
      "fields": [
        "ma_kh",
        "ten_kh",
        "ma_vt",
        "ten_vt",
        "sl_min",
        "dvt",
        "gia0",
        "gia",
        "ma_nt",
        "ngay_bd",
        "ngay_kt",
        "status"
      ],
      "validation": "pending_ui_validation",
      "manifest": "config/erp-reports/danh-muc-bang-gia.json",
      "query_file": "sql/erp-reports/agent-price-list.sql",
      "parameters": [
        "user_id",
        "material",
        "date_as_of",
        "row_limit"
      ]
    },
    {
      "id": "product_structure",
      "title": "Cấu trúc sản phẩm và định mức BOM",
      "tables": [
        "public.mfbom",
        "public.mfbom_material",
        "public.dmvt"
      ],
      "join": "mfbom.bom_code = mfbom_material.bom_code",
      "fields": [
        "ma_sp_me",
        "bom_code",
        "bom_version",
        "status",
        "valid_from",
        "valid_to",
        "material_code",
        "ten_vt",
        "sl_dinh_muc",
        "dvt"
      ],
      "validation": "pending_ui_validation",
      "manifest": "config/erp-reports/bao-cao-cau-truc-san-pham.json",
      "query_file": "sql/erp-reports/agent-product-structure.sql",
      "parameters": [
        "user_id",
        "material",
        "date_as_of",
        "row_limit"
      ]
    },
    {
      "id": "customer_master",
      "title": "Danh mục khách hàng",
      "tables": [
        "public.dmkh"
      ],
      "join": "none",
      "fields": [
        "ma_kh",
        "ten_kh",
        "ten_viet_tat",
        "dien_thoai",
        "dia_chi",
        "status"
      ],
      "validation": "pending_ui_validation",
      "manifest": "config/erp-reports/danh-muc-khach-hang.json",
      "query_file": "sql/erp-reports/agent-customer-master.sql",
      "parameters": [
        "user_id",
        "query_text",
        "query_text",
        "query_text",
        "row_limit"
      ]
    },
    {
      "id": "inventory_balance",
      "title": "Báo cáo tồn kho sổ sách",
      "tables": [
        "public.cdvt",
        "public.ct70",
        "public.dmvt"
      ],
      "join": "cdvt union all ct70",
      "fields": [
        "ma_vt",
        "ten_vt",
        "dvt",
        "so_luong_ton"
      ],
      "validation": "pending_ui_validation",
      "manifest": "config/erp-reports/bao-cao-ton-kho.json",
      "query_file": "sql/erp-reports/agent-inventory-balance.sql",
      "parameters": [
        "user_id",
        "date_as_of",
        "material",
        "material",
        "date_as_of",
        "date_as_of",
        "row_limit"
      ]
    },
    {
      "id": "receipt_lines",
      "title": "Bảng kê phiếu nhập kho",
      "tables": [
        "public.ct70",
        "public.userinfo"
      ],
      "join": "ct70 left join userinfo on userinfo.user_id = ct70.user_id0",
      "fields": [
        "stt_rec",
        "ln",
        "so_ct",
        "ngay_ct",
        "date0",
        "time0",
        "ma_kho",
        "dvt",
        "sl_nhap",
        "nguoi_nhap",
        "kho_xuat"
      ],
      "validation": "pending_ui_validation",
      "manifest": "config/erp-reports/bang-ke-phieu-nhap-kho.json",
      "query_file": "sql/erp-reports/agent-receipt-lines.sql",
      "parameters": [
        "material",
        "date_from",
        "date_to",
        "user_id",
        "row_limit"
      ]
    },
    {
      "id": "forecast_po",
      "title": "Kế hoạch PO và dự báo FCST",
      "tables": [
        "public.mfkhsx_po_fc"
      ],
      "join": "none",
      "fields": [
        "id",
