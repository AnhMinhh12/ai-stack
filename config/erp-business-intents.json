      "match": {"all": ["ma_vt"], "any": ["giao gan nhat", "lan giao gan nhat", "lot giao gan nhat", "lo giao gan nhat", "dot giao gan nhat", "lot gan nhat", "lo gan nhat", "xuat giao gan nhat", "xuat gan nhat", "lan xuat gan nhat", "dot xuat gan nhat"]},
