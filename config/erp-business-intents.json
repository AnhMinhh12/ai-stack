    },
    {
      "id": "purchased_material_any",
      "description": "Chọn một mã hàng mua có chứng từ đơn mua thực tế; loại trừ BTP/TP do công ty sản xuất (loại 41/51).",
      "match": {"all": ["mua", "ma"], "any": ["bat ky", "ma nao", "ngau nhien"]},
