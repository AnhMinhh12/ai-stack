    {
      "id": "htmp_postgres_query",
      "name": "Tra cứu PostgreSQL ERP",
      "source": "htmp_postgres_query.py",
      "description": "Read-only ERP PostgreSQL query tool",
      "type": "tool",
      "specs": [
        {
          "name": "find_material_by_code",
          "description": "FIRST choice for questions asking which warehouse(s) contain a material code (ma_vt). Searches real ma_vt and ma_kho columns; never invent table names.",
          "parameters": {
            "type": "object",
            "properties": {
              "ma_vt": {
                "type": "string",
                "description": "Exact material code, e.g. RC6-8801-000."
              }
            },
            "required": [
              "ma_vt"
            ]
          }
        },
        {
          "name": "find_materials_in_warehouse",
          "description": "FIRST choice for questions asking material codes in a warehouse. Searches real ma_kho and ma_vt columns; never invent table names.",
          "parameters": {
            "type": "object",
            "properties": {
              "ma_kho": {
                "type": "string",
                "description": "Exact warehouse code, e.g. KHO-XHLOT2."
              }
            },
            "required": [
              "ma_kho"
            ]
          }
        },
        {
          "name": "get_erp_schema",
          "description": "Use before ERP queries to find tables and columns. Always use this for natural-language ERP questions.",
          "parameters": {
            "type": "object",
            "properties": {
              "search": {
                "type": "string",
                "description": "Business term, table name, or column name."
              }
            },
            "required": []
          }
        },
        {
          "name": "query_erp_database",
          "description": "Run one read-only SELECT/WITH ERP query after schema lookup.",
          "parameters": {
            "type": "object",
            "properties": {
              "sql": {
                "type": "string",
                "description": "One PostgreSQL SELECT or WITH query."
              }
            },
            "required": [
              "sql"
            ]
          }
        }
      ]
    }
  ],
