FROM node:22-alpine3.20 AS frontend

ARG BUILD_HASH=d3e8bf3405e848cfba377814d0aa7ba7290e414d-htmp-speed
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --force

COPY . .
ENV APP_BUILD_HASH=${BUILD_HASH}
RUN npm run build

FROM open-webui-htmp:libreoffice

COPY --from=frontend /app/build /app/build

LABEL org.opencontainers.image.description="HTMP Open WebUI with a Speed selector"
