# Copy to a protected release environment; never commit real credentials.
HTMP_REGISTRY=registry.htmp.internal
HTMP_REGISTRY_NAMESPACE=ai
# Generated only by scripts/build_release_image.sh; must be image@sha256:...
HTMP_OPEN_WEBUI_IMAGE=registry.htmp.internal/ai/open-webui-htmp@sha256:REPLACE_AFTER_PUSH
OPENWEBUI_BOOTSTRAP_OWNER_EMAIL=hoanhminhz@gmail.com

# ERP PostgreSQL read-only tool (do not commit real credentials).
HTMP_DB_HOST=10.0.6.2
HTMP_DB_PORT=5410
HTMP_DB_NAME=3SERP_HTMP_DATA
HTMP_DB_USER=REPLACE_WITH_READ_ONLY_USER
HTMP_DB_PASSWORD=REPLACE_WITH_READ_ONLY_PASSWORD
HTMP_DB_MAX_ROWS=200
HTMP_DB_STATEMENT_TIMEOUT_MS=15000
# JSON object managed only by the server administrator. Keys are Open WebUI
# user UUIDs or lowercase emails; values are public.userinfo.user_id integers.
HTMP_ERP_USER_ID_MAP={"OPEN_WEBUI_USER_UUID":123}
# Optional shared service identity when every chat user intentionally has the
# same ERP scope. Leave empty to require the per-user mapping above.
HTMP_ERP_SHARED_USER_ID=11
